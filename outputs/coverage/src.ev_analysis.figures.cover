   16:             body += f'<line x1="{previous[1]:.2f}" y1="{previous[2]:.2f}" x2="{px:.2f}" y2="{py:.2f}" stroke="#2877b5" stroke-width="1"/>'
   68:         color = '#e05a25' if highlights and index in highlights else '#2877b5'
   68:         body += f'<circle cx="{px:.2f}" cy="{py:.2f}" r="{3 if line else 4}" fill="{color}" opacity=".7"><title>{escape(x_label)}={x:.6g}; {escape(y_label)}={y:.6g}</title></circle>'
   68:         previous = (index, px, py)
   52:     path.write_text(frame(title, body, x_label, y_label), encoding="utf-8")
       
       
