    1: def correlation_matrix(path: Path, windows: list[dict], fields: list[str]) -> None:
    2:     size = 58
    2:     body = ''
   16:     for i, field in enumerate(fields):
   14:         body += f'<text x="5" y="{180+i*size+32}" font-size="10">{escape(field)}</text>'
   14:         body += f'<text transform="translate({230+i*size+30},170) rotate(-55)">{escape(field)}</text>'
  112:         for j, other in enumerate(fields):
  294:             value = pearson([w[field] for w in windows], [w[other] for w in windows])
   98:             opacity = abs(value) if value is not None else 0
   98:             color = '#dc5a39' if value is not None and value > 0 else '#2877b5'
   98:             body += f'<rect x="{230+j*size}" y="{180+i*size}" width="{size}" height="{size}" fill="{color}" fill-opacity="{opacity:.3f}" stroke="#e0e0e0"/>'
   98:             text = f'{value:.2f}' if value is not None else 'NA'
   98:             body += f'<text x="{238+j*size}" y="{213+i*size}">{text}</text>'
    6:     path.write_text(frame('Pearson correlation: eligible operating periods', body,
    4:                           width=230+size*len(fields)+30, height=220+size*len(fields)), encoding="utf-8")
