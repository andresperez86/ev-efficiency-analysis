    1: """Stable JSON/CSV exports, dictionary, and stakeholder findings."""
       
    1: import csv
    1: import json
    1: from math import isfinite
    1: from pathlib import Path
       
    1: from .ingestion import COLUMNS, NUMERIC
       
       
    1: def serializable(value):
 6166:     if isinstance(value, float) and not isfinite(value):
>>>>>>         return None
 6166:     if isinstance(value, dict):
  766:         return {k: serializable(v) for k, v in value.items()}
 6102:     if isinstance(value, (list, tuple)):
   56:         return [serializable(v) for v in value]
 6080:     return value
       
       
    1: def write_json(path: Path, value) -> None:
   20:     path.write_text(json.dumps(serializable(value), indent=2, sort_keys=True, allow_nan=False) + '\n', encoding="utf-8")
       
       
    1: def write_csv(path: Path, rows: list[dict], fields: list[str] | None = None) -> None:
 6262:     columns = fields or list(dict.fromkeys(k for row in rows for k in row))
   64:     with path.open('w', encoding='utf-8', newline='') as stream:
   32:         writer = csv.DictWriter(stream, fieldnames=columns)
   32:         writer.writeheader()
  822:         for row in rows:
 6200:             writer.writerow({k: serializable(row.get(k)) for k in columns})
       
       
    1: def dictionary(quality: dict) -> list[dict]:
   16:     meanings = {
   16:         "timestamp": ("datetime", "UTC-05:00", "Analysis timestamp in local competition time", "Integration", "Original preprocessing method undocumented"),
   16:         "car_velocity": ("float", "km/h", "Vehicle speed", "Explanatory", "Seven quantized levels; sensor calibration undocumented"),
   16:         "car_trip": ("float", "km", "Cumulative trip distance", "Target denominator", "Use interval increments; do not subtract origin from energy independently"),
   16:         "car_voltage": ("float", "V", "Electrical voltage", "Descriptive and quality", "Measurement location unknown; final near-zero values are shutdown"),
   16:         "car_current": ("float", "A", "Electrical current; positive means discharge", "Target construction and descriptive", "No regeneration; negative values are flagged artifacts until explained"),
   16:         "power": ("float", "W", "Electrical power, numerically equal to voltage times current", "Target construction and descriptive", "Clip negative values to zero only on quality-valid support"),
   16:         "gps_1": ("float", "degrees (provisional)", "Likely latitude", "GPS exploratory only", "Coordinate order/reference system and finish line require confirmation"),
   16:         "gps_2": ("float", "degrees (provisional)", "Likely longitude", "GPS exploratory only", "Stationary jitter; not the primary distance source"),
   16:         "timestamp_original": ("datetime text", "UTC-05:00", "Timestamp before preprocessing", "Provenance", "Matches timestamp in this file"),
   16:         "retroceso_detectado": ("boolean text", "none", "Preprocessing reversal flag", "Provenance", "Exact preprocessing definition undocumented; constant False"),
   16:         "segmento": ("integer text", "none", "Preprocessing segment identifier", "Provenance", "Constant 1; not a lap identifier"),
           }
   16:     rows = []
  192:     for column in COLUMNS:
  176:         dtype, unit, meaning, role, caveat = meanings[column]
  176:         observed = quality['numeric'].get(column, {})
  352:         rows.append({"column": column, "canonical_field": NUMERIC.get(column, column), "type": dtype,
  176:                      "unit": unit, "meaning": meaning, "analysis_role": role, "caveat": caveat,
  176:                      "missing_count": quality['missing_values'][column],
  176:                      "constant": column in quality['constant_columns'],
  176:                      "observed_min": observed.get('min'), "observed_max": observed.get('max'),
  176:                      "nonfinite_count": observed.get('nonfinite_count', 0)})
   16:     return rows
       
       
    3: def findings(quality: dict, metrics: dict, comparisons: dict, relationships: list[dict], modeling: dict,
    2:              sensitivity: list[dict]) -> str:
    4:     lines = ['# EIA telemetry findings', '',
    2:              'This report describes one session and fixed-time operating periods, not reconstructed laps. Associations do not establish causality.', '',
    2:              f"Source: {quality['rows']} rows, {quality['columns']} columns; {quality['time_start']} to {quality['time_end']}.",
    2:              f"Missing fields: {sum(quality['missing_values'].values())}; duplicate rows: {quality['duplicate_rows']}; backward trip increments: {quality['trip_decreases']}.",
    2:              f"Flags: {json.dumps(quality['quality_flag_counts'], sort_keys=True)}.",
    2:              'Speed is heavily quantized. Derivative features are proxies and event counts are threshold-dependent.',
    2:              'Shutdown and intervals touching invalid voltage are excluded. Negative electrical values are never interpreted as regeneration.', '',
    2:              '## Energy accounting', '',
    2:              f"Consumed energy: {metrics['consumed_wh']:.6f} Wh; valid distance: {metrics['distance_km']:.6f} km.",
    2:              f"Wh/km: {metrics['wh_per_km']}; moving-only Wh/km: {metrics['moving_wh_per_km']}.",
    2:              f"Stationary energy: {metrics['stationary_wh']:.6f} Wh; stopped time: {metrics['stopped_s']:.3f} s.",
    2:              f"Accepted intervals: {metrics['valid_interval_count']}; excluded: {metrics['excluded_interval_count']}; full-record time coverage: {metrics['coverage_fraction']}.",
    2:              f"Raw signed energy diagnostic including post-run: {metrics['raw_signed_wh_diagnostic']:.6f} Wh. This is not consumed or recovered energy.", '',
    2:              'Wh/km = sum of trapezoidal, nonnegative discharge energy over accepted intervals / sum of trip increments over the same intervals. Endpoint powers are clipped before piecewise-linear integration. Moving/stopped splits use linearly interpolated speed threshold crossings; trip distance is apportioned linearly within each original interval.', '',
    2:              '## Descriptive candidate ranking', '',
    2:              '| Rank | Candidate | Pearson | Spearman | Exploratory Spearman interval |',
    2:              '|---|---|---|---|---|']
   34:     for row in relationships:
   32:         def fmt(value):
  128:             return f'{value:.3f}' if value is not None else 'NA'
   32:         lines.append(f"| {row['descriptive_rank']} | {row['feature']} | {fmt(row['pearson'])} | {fmt(row['spearman'])} | {fmt(row['spearman_block_bootstrap_p025'])} to {fmt(row['spearman_block_bootstrap_p975'])} |")
    4:     lines += ['', 'Ranking score is the mean absolute Pearson/Spearman association. It is not a predictive ranking or an intervention recommendation. Speed bands, stopped percentage and speed summaries are correlated proxies. Speed/pace and Wh/km also share distance/time relationships; their association can partly reflect mathematical coupling.', '',
    2:               '## Efficiency and performance', '', f"Eligible periods: {comparisons.get('eligible_count', 0)}."]
    2:     if comparisons.get('eligible_count'):
    4:         lines += [f"Most/least efficient period: {comparisons['most_efficient_period']} / {comparisons['least_efficient_period']}.",
    2:                   f"Fastest/slowest period: {comparisons['fastest_period']} / {comparisons['slowest_period']}.",
    2:                   f"Pareto periods: {comparisons['pareto_periods']}.",
    2:                   f"Efficient quartile medians: {json.dumps(comparisons['efficient_quartile_medians'], sort_keys=True)}.",
    2:                   f"Inefficient quartile medians: {json.dumps(comparisons['inefficient_quartile_medians'], sort_keys=True)}.",
    2:                   'Pace-matched pairs are exported at a 2 km/h tolerance. They remain confounded by course position, elapsed session time and operating conditions. An acceptable pace floor must be selected by the racing team before recommending a strategy.']
    4:     lines += ['', '## Sensitivity', '',
    2:               '30/60/120-second window results and an alternative negative-artifact exclusion accounting are exported. The window origin is the first source timestamp. Thresholds are analysis policies, not confirmed sensor limits.',
    2:               json.dumps(sensitivity, sort_keys=True), '', '## Predictive analysis status', '',
    2:               f"Status: {modeling['status']}. See modeling.json for method availability and forward-block validation results.",
    2:               'Mutual information, Random Forest, permutation importance and SHAP require optional dependencies. Missing methods have no fabricated scores.', '',
    2:               '## Limitations and next steps', '',
    2:               '- One session; no independent session-level validation. Periods may be serially dependent; block-bootstrap intervals are exploratory, not multiplicity adjusted.',
    2:               '- No lap labels, start/finish line, temperatures, elevation, throttle or brake channels. GPS order and reference system are provisional.',
    2:               '- Power is a target component. Current, power, energy, voltage and distance are excluded from the explanatory model allowlist.',
    2:               '- Negative values may understate consumption after clipping. The sensitivity accounting excludes adjacent artifact intervals and reports coverage.',
    2:               '- Default shutdown detection uses the trailing stationary run at voltage magnitude <=10 V, capturing the observed collapse before readings fall below 1 V. Sensitivity at 1/10/40 V is exported. The 10 V cutoff is a dataset-specific policy, not an engineering battery limit. No missing values are imputed and no long gaps are bridged.',
    2:               '- Quantized speed limits acceleration interpretation. Median/percentile speed features are duration-weighted interval-midpoint approximations.',
    2:               '- Confirm GPS coordinate reference system and a directed finish-line segment. Then validate crossing-based laps with minimum crossing time, rearm distance and a GPS-jitter tolerance; discard incomplete first/last laps explicitly.',
    2:               '- Collect more complete sessions and comparable laps; confirm electrical calibration and a race-pace floor before controlled driving experiments.', '']
    2:     return '\n'.join(lines)
