    1: """Optional predictive importance, evaluated on forward contiguous blocks."""
       
    1: from statistics import fmean, pstdev
       
    1: from .features import EXPLANATORY_FEATURES
       
       
    1: def model_importance(windows: list[dict], seed: int = 42) -> dict:
   31:     eligible = [w for w in windows if w["model_eligible"]]
    4:     if len(eligible) < 20:
    3:         return {"status": "insufficient_periods", "eligible_periods": len(eligible), "minimum": 20}
    1:     try:
    1:         import numpy as np
>>>>>>         from sklearn.ensemble import RandomForestRegressor
>>>>>>         from sklearn.feature_selection import mutual_info_regression
>>>>>>         from sklearn.inspection import permutation_importance
