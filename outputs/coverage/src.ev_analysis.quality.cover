    1: def numeric_summary(values: list[float]) -> dict:
  130:     finite = sorted(v for v in values if isfinite(v))
   34:     if not finite:
>>>>>>         return {"finite_count": 0, "nonfinite_count": len(values)}
   34:     def quantile(p: float) -> float:
   68:         pos = (len(finite) - 1) * p
   68:         lo = int(pos)
   68:         hi = min(lo + 1, len(finite) - 1)
   68:         return finite[lo] + (finite[hi] - finite[lo]) * (pos - lo)
   34:     q1, q3 = quantile(.25), quantile(.75)
   34:     iqr = q3 - q1
   68:     return {"finite_count": len(finite), "nonfinite_count": len(values) - len(finite),
   34:             "min": finite[0], "p25": q1, "median": median(finite), "p75": q3,
   34:             "max": finite[-1], "mean": fmean(finite), "std": pstdev(finite),
  130:             "unique_count": len(set(finite)), "negative_count": sum(v < 0 for v in finite),
  130:             "iqr_outlier_count_diagnostic": sum(v < q1 - 1.5 * iqr or v > q3 + 1.5 * iqr for v in finite)}
       
       
    3: def profile(samples: list[Sample], columns: list[str], records: list[dict[str, str]],
