   30:     return {"rows": len(samples), "columns": len(columns),
    4:             "time_start": min(times).isoformat(), "time_end": max(times).isoformat(),
    2:             "sampling_interval_s": numeric_summary(dt),
  160:             "missing_values": {c: sum(r.get(c) is None or r[c].strip().lower() in
  158:                                       ("", "nan", "null", "none", "na", "n/a") for r in records) for c in columns},
   56:             "duplicate_rows": len(records) - len(set(tuple(r.get(c) for c in columns) for r in records)),
    2:             "duplicate_timestamps": len(times) - len(set(times)),
    6:             "nonpositive_intervals": sum(t <= 0 for t in dt),
   90:             "constant_columns": [c for c in columns if len(set(r.get(c) for r in records)) == 1],
    6:             "trip_decreases": sum(b.trip_km < a.trip_km for a, b in zip(samples, samples[1:])),
    8:             "timestamp_changed_rows": sum(r["timestamp"] != r["timestamp_original"] for r in records),
   44:             "numeric": {column: numeric_summary([getattr(s, field) for s in samples]) for column, field in NUMERIC.items()},
    2:             "quality_flag_counts": counts,
