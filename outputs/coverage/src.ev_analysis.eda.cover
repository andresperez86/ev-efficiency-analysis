  320:                  if isinstance(w.get(field), (int, float)) and isfinite(w[field])]
  496:         x, y = [p[0] for p in pairs], [p[1] for p in pairs]
  176:         r, rho = pearson(x, y), spearman(x, y)
               # Exploratory moving-block bootstrap; never cross an excluded period.
  304:         blocks = [pairs[i:i+3] for i in range(max(0, len(pairs)-2))
   64:                   if pairs[i+2][2] - pairs[i][2] == 2]
  176:         bootstrap = []
  176:         rng = Random(seed)
  176:         if len(pairs) >= 9 and blocks:
>>>>>>             for _ in range(300):
>>>>>>                 draw = []
>>>>>>                 while len(draw) < len(pairs):
>>>>>>                     draw.extend(rng.choice(blocks))
>>>>>>                 draw = draw[:len(pairs)]
>>>>>>                 value = spearman([p[0] for p in draw], [p[1] for p in draw])
>>>>>>                 if value is not None:
>>>>>>                     bootstrap.append(value)
  176:         bootstrap.sort()
  224:         score = fmean(abs(v) for v in (r, rho) if v is not None) if r is not None or rho is not None else None
  352:         table.append({"feature": field, "n": len(pairs), "pearson": r, "spearman": rho,
  176:                       "association_score": score,
  176:                       "direction_disagrees": r is not None and rho is not None and r * rho < 0,
  176:                       "spearman_block_bootstrap_p025": bootstrap[int(.025*(len(bootstrap)-1))] if bootstrap else None,
  176:                       "spearman_block_bootstrap_p975": bootstrap[int(.975*(len(bootstrap)-1))] if bootstrap else None,
  176:                       "interpretation": "Descriptive association; no causal claim; exploratory bootstrap, not multiplicity adjusted"})
  187:     table.sort(key=lambda row: row["association_score"] if row["association_score"] is not None else -1, reverse=True)
  187:     for i, row in enumerate(table, 1):
  176:         row["descriptive_rank"] = i
   11:     return table
       
       
    1: def pareto_front(windows: list[dict]) -> list[int]:
   29:     return [w["period_id"] for w in windows if not any(
   27:         v["wh_per_km"] <= w["wh_per_km"] and v["average_speed_kmh"] >= w["average_speed_kmh"]
   10:         and (v["wh_per_km"] < w["wh_per_km"] or v["average_speed_kmh"] > w["average_speed_kmh"])
   32:         for v in windows)]
       
       
