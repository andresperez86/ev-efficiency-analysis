    1: def pearson(x: list[float], y: list[float]) -> float | None:
 1515:     if len(x) != len(y):
    1:         raise ValueError("Correlation vectors must have equal lengths")
 3099:     pairs = [(a, b) for a, b in zip(x, y) if isfinite(a) and isfinite(b)]
 1514:     if len(pairs) < 3:
 1479:         return None
   35:     a, b = zip(*pairs)
   35:     ma, mb = fmean(a), fmean(b)
  507:     va, vb = fsum((v - ma)**2 for v in a), fsum((v - mb)**2 for v in b)
   35:     if va == 0 or vb == 0:
    1:         return None
  266:     return max(-1.0, min(1.0, fsum((u - ma)*(v - mb) for u, v in pairs) / sqrt(va * vb)))
       
       
    1: def ranks(values: list[float]) -> list[float]:
 1318:     ordered = sorted(range(len(values)), key=values.__getitem__)
 1318:     result = [0.0] * len(values)
 1318:     start = 0
 2798:     while start < len(ordered):
 1480:         end = start + 1
 1482:         while end < len(ordered) and values[ordered[end]] == values[ordered[start]]:
    2:             end += 1
 2962:         for i in ordered[start:end]:
 1482:             result[i] = (start + end + 1) / 2
 1480:         start = end
 1318:     return result
       
       
    1: def spearman(x: list[float], y: list[float]) -> float | None:
  755:     if len(x) != len(y):
>>>>>>         raise ValueError("Correlation vectors must have equal lengths")
 1496:     pairs = [(a, b) for a, b in zip(x, y) if isfinite(a) and isfinite(b)]
  755:     if not pairs:
   96:         return None
  659:     a, b = zip(*pairs)
  659:     return pearson(ranks(list(a)), ranks(list(b)))
       
       
    1: def relationship_table(windows: list[dict], seed: int = 42) -> list[dict]:
